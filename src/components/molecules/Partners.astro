---
import raLogo from "../../assets/logos/ra.png";
import nplbLogo from "../../assets/logos/nplb.png";
import oxfordLogo from "../../assets/logos/oxford.png";
import uclLogo from "../../assets/logos/ucl.png";
import imperialLogo from "../../assets/logos/imperial.png";
import usLogo from "../../assets/logos/us.png";
---

<div
  class="xs:gap-2 xs:h-6 flex h-5 items-center justify-between gap-1 lg:h-10 lg:justify-end"
>
  <img
    src={raLogo.src}
    width={raLogo.width}
    height={raLogo.height}
    alt="RA Capital"
    class="h-full flex-0"
  />
  <img
    src={nplbLogo.src}
    width={nplbLogo.width}
    height={nplbLogo.height}
    alt="NPLB"
    class="h-full flex-0"
  />
  <img
    src={oxfordLogo.src}
    width={oxfordLogo.width}
    height={oxfordLogo.height}
    alt="University of Oxford"
    class="h-full flex-0"
  />
  <img
    src={uclLogo.src}
    width={uclLogo.width}
    height={uclLogo.height}
    alt="Univercity College London"
    class="h-full flex-0"
  />
  <img
    src={imperialLogo.src}
    width={imperialLogo.width}
    height={imperialLogo.height}
    alt="Imperial College"
    class="h-full flex-0"
  />
  <img
    src={usLogo.src}
    width={usLogo.width}
    height={usLogo.height}
    alt="University of Southampton"
    class="h-full flex-0"
  />
</div>
