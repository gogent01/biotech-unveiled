---
interface Props {
  href: string;
  target?: string;
  class?: string;
  dataUmamiEvent?: string;
}

const { href, class: className, target, dataUmamiEvent } = Astro.props;
---

<a
  href={href}
  target={target}
  class:list={[
    "inline-block underline underline-offset-2 transition-colors hover:decoration-transparent",
    className,
  ]}
  data-umami-event={dataUmamiEvent}
>
  <slot />
</a>

<style>
  a {
    text-decoration-thickness: 0.5px;
    line-height: 135%;
  }
</style>
