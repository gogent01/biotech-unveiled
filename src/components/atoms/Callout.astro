---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex w-full justify-center", className]}>
  <p
    class:list={[
      "font-display text-primary text-center text-sm uppercase lg:text-2xl",
    ]}
  >
    <slot />
  </p>
</div>

<style>
  p {
    line-height: 165%;
    letter-spacing: 4%;
    max-width: 60ch;
  }

  @media screen and (min-width: 64rem) {
    p {
      letter-spacing: 6%;
    }
  }
</style>
