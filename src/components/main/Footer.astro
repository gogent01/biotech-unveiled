---
import Link from "../atoms/Link.astro";
---

<footer
  id="contacts"
  class="mx-auto mt-10 max-w-md scroll-mt-64 p-4 sm:max-w-none sm:scroll-mt-108 lg:mt-36 lg:scroll-mt-172 lg:px-15 lg:py-6"
>
  <h2 class="text-sm font-bold lg:text-2xl">Contacts</h2>

  <dl class="mt-2 space-y-2.5 text-sm lg:text-2xl">
    <div class="lg:flex lg:items-baseline lg:gap-2">
      <dt>Daur Meretukov</dt>
      <dd>
        <Link href="mailto:daur.meretukov@wolf.ox.ac.uk"
          >daur.meretukov@wolf.ox.ac.uk</Link
        >
      </dd>
    </div>

    <div class="lg:flex lg:items-baseline lg:gap-2">
      <dt>Zohar Preminger</dt>
      <dd>
        <Link href="mailto:zohar.preminger.22@ucl.ac.uk"
          >zohar.preminger.22@ucl.ac.uk</Link
        >
      </dd>
    </div>

    <div class="lg:flex lg:items-baseline lg:gap-2">
      <dt>Celine Shin</dt>
      <dd>
        <Link href="mailto:cel.shin01@gmail.com">cel.shin01@gmail.com</Link>
      </dd>
    </div>

    <div class="lg:flex lg:items-baseline lg:gap-2">
      <dt>Yushi Li</dt>
      <dd>
        <Link href="mailto:yushi.li@new.ox.ac.uk">yushi.li@new.ox.ac.uk</Link>
      </dd>
    </div>

    <div class="lg:flex lg:items-baseline lg:gap-2">
      <dt>Weronika Biala</dt>
      <dd>
        <Link href="mailto:w.biala@soton.ac.uk">w.biala@soton.ac.uk</Link>
      </dd>
    </div>
  </dl>

  <div class="sm:hidden">
    <Link
      href="https://www.nopatientleftbehind.org/nplb-fellowship"
      target="_blank"
      class="mt-6 block text-sm">The <abbr>NPLB</abbr> Biotech Fellowship</Link
    >

    <div id="credits" class="mt-11 flex gap-4">
      <p class="text-xs">© 2026<br />Biotech Unveiled</p>
      <p class="text-xs">
        Designed and developed<br /><Link
          href="https://trivialno.com"
          target="_blank">by Trivialno</Link
        > in 2026
      </p>
    </div>
  </div>

  <div class="hidden items-end gap-x-6 sm:flex lg:hidden">
    <div id="credits" class="mt-11 flex gap-4">
      <p class="text-xs">© 2026 Biotech Unveiled</p>
      <p class="text-xs">
        <span class="inline-block">Designed and developed</span>
        <span class="inline-block"
          ><Link href="https://trivialno.com" target="_blank">by Trivialno</Link
          > in 2026</span
        >
      </p>
    </div>

    <Link
      href="https://www.nopatientleftbehind.org/nplb-fellowship"
      target="_blank"
      class="ml-auto block shrink-0 text-sm"
      >The <abbr>NPLB</abbr> Biotech Fellowship</Link
    >
  </div>

  <div class="mt-10 hidden gap-6 lg:flex">
    <div id="credits" class="flex gap-4">
      <p class="text-sm">© 2026 Biotech Unveiled</p>
      <p class="text-sm">
        Designed and developed <Link
          href="https://trivialno.com"
          target="_blank">by Trivialno</Link
        > in 2026
      </p>
    </div>

    <Link
      href="https://www.nopatientleftbehind.org/nplb-fellowship"
      target="_blank"
      class="ml-auto block"
      dataUmamiEvent="Fellowship Link"
      >The <abbr>NPLB</abbr> Biotech Fellowship</Link
    >
  </div>
</footer>

<style>
  @reference '../../styles/global.css';

  dl {
    line-height: 115%;
  }

  dt {
    @apply font-bold;
  }

  #credits p {
    line-height: 125%;
  }
</style>
