---
import spiralImage from "../../assets/spiral.svg";
import { PUBLIC_COURSE_DEADLINE } from "astro:env/client";
import { isValidDateString, toShortMonthDay } from "../../utils";
---

<div class="tech-gradient mt-4 overflow-hidden lg:mt-16">
  <div
    class="mx-auto max-w-md p-4 pt-8 pb-12 text-pretty text-white sm:grid sm:max-w-360 sm:grid-cols-7 sm:gap-x-8 lg:px-16 lg:py-14 lg:pb-22"
  >
    <div
      class="max-w-102 sm:col-span-6 sm:col-start-1 lg:col-span-3 lg:col-start-3 lg:-mx-0.5 lg:max-w-none"
    >
      <div class="relative">
        <div
          class="pointer-events-none absolute -top-36 -left-180 mix-blend-color-dodge lg:-top-32 lg:-left-300 lg:block xl:-top-48 xl:-left-300"
          style="width: 40rem; transform: rotate(-64deg) scale(0.9, 1) translateY(-25%); transform-origin: top left;"
        >
          <img src={spiralImage.src} alt="" class="w-full -scale-100" />
        </div>
        <h2
          class="font-display pb-14 text-3xl font-bold lg:max-w-min lg:pb-32 lg:text-5xl xl:max-w-none"
          style="line-height: 110%; letter-spacing: -2%;"
        >
          Ready to understand biotech as a system?
        </h2>
      </div>

      <h3>Step 1</h3>
      <p>Take the free course.</p>

      <h3>Step 2</h3>
      <p>Complete it and earn the certificate.</p>

      <h3>Step 3</h3>
      <p>
        Use it as your bridge to the <abbr>NPLB</abbr> Biotech Fellowship. {
          isValidDateString(PUBLIC_COURSE_DEADLINE) && (
            <em class="text-accent-light not-italic">
              {`Application deadline: ${toShortMonthDay(
                new Date(PUBLIC_COURSE_DEADLINE),
              )}`.replaceAll(" ", " ")}
            </em>
          )
        }
      </p>

      <a
        href="https://racap.thinkific.com/courses/biotechunveiled?utm_source=BucketChallenge&utm_medium=BucketChallenge&utm_campaign=Team2"
        class="font-display bg-accent hover:bg-accent-mix-1 mt-7 inline-block rounded px-5 pt-1.5 pb-2 text-xl font-medium text-white transition-colors lg:mt-8 lg:pb-2.75 lg:text-3xl"
        style="letter-spacing: -0.4%"
        data-umami-event="Course Button"
      >
        Join the course
      </a>
    </div>
  </div>
</div>

<style>
  @reference '../../styles/global.css';

  .tech-gradient {
    background-image: radial-gradient(
      at 110% 7.5%,
      var(--color-accent) 0%,
      var(--color-accent-mix-1) 10%,
      var(--color-accent-mix-2) 25%,
      var(--color-primary) 75%
    );
  }

  @media screen and (min-width: 64rem) {
    .tech-gradient {
      background-image: radial-gradient(
        at 80% 0%,
        var(--color-accent) 0%,
        var(--color-accent-mix-1) 7.5%,
        var(--color-accent-mix-2) 35%,
        var(--color-primary) 80%
      );
    }
  }

  h3 {
    @apply font-display mt-4 text-xl font-bold lg:mt-6 lg:text-3xl;
    line-height: 92%;
    letter-spacing: -2%;
  }

  p {
    @apply mt-1 lg:mt-3 lg:text-2xl;
    line-height: 135%;
    letter-spacing: -2%;
  }
</style>
