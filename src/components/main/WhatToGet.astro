---
import Callout from "../atoms/Callout.astro";
import nplbFellowshipLogo from "../../assets/logos/nplb-fellowship.png";
import Link from "../atoms/Link.astro";
import { PUBLIC_COURSE_DEADLINE } from "astro:env/client";
import {
  isValidDateString,
  toLongMonthDayYear,
  toShortMonthDay,
} from "../../utils";
---

<section
  class="mx-auto mt-11 max-w-md p-4 sm:grid sm:max-w-360 sm:grid-cols-7 sm:gap-x-8 lg:mt-28 lg:px-15 lg:py-6"
>
  <h2
    class="font-display text-primary text-xl font-bold sm:col-span-2 lg:text-4xl"
    style="line-height: 110%"
  >
    What will I get?
  </h2>

  <ul
    class="mt-4 ml-4 list-outside list-disc list-image-[url(/icons/bullit.svg)] space-y-4 text-pretty sm:col-span-4 sm:mt-px lg:mt-2 lg:ml-5 lg:list-image-[url(/icons/bullit-large.svg)] lg:space-y-6 lg:text-2xl"
  >
    <li>
      A solid understanding in how the biotech ecosystem works in the modern
      world
    </li>
    <li>A reputable certificate of completion from <abbr>RA</abbr> Capital</li>
    <li>
      An opportunity to apply for <Link
        href="https://www.nopatientleftbehind.org/nplb-fellowship"
        target="_blank"
        dataUmamiEvent="Fellowship Link"
        >the <abbr>NPLB</abbr> Biotech Fellowship</Link
      > — <em class="text-accent not-italic"
        >the certificate of completion is a prerequisite for enrollment</em
      >
    </li>
  </ul>

  <div
    class="border-border relative mt-12 max-w-124 rounded-sm border-2 p-5 pr-8 pb-10 sm:col-span-4 sm:col-start-3 lg:mt-25 lg:max-w-none lg:p-7 lg:pr-16 lg:pb-14"
  >
    <img
      src={nplbFellowshipLogo.src}
      width={nplbFellowshipLogo.width}
      height={nplbFellowshipLogo.height}
      alt="NPLB Fellowship"
      class="absolute -top-11 -right-4 w-28 lg:-top-17 lg:-right-20 lg:w-44"
    />

    <h3
      class="font-display text-primary font-bold lg:text-2xl"
      style="line-height: 110%;"
    >
      About <abbr>NPLB</abbr> Fellowship
    </h3>

    <ul
      class="mt-6 ml-4 list-outside list-image-[url(/icons/check.svg)] space-y-2.5 text-pretty lg:mt-9 lg:ml-6 lg:list-image-[url(/icons/check-large.svg)] lg:space-y-6 lg:text-2xl"
    >
      <li>
        A joint <abbr>NPLB</abbr> and <abbr>RA</abbr> Capital 3-months intensive
        live program for the future biotech leaders
      </li>
      <li>
        Eligible for everyone interested in Biotech industry and completed
        the Biotech Unveiled course
      </li>
      <li>
        Live sessions with experts from the biotech industry on investments,
        R&D, pricing, policy and much more
      </li>
      <li>
        Mentoring from leadership of <abbr>RA</abbr> Capital and <abbr
          >NPLB</abbr
        >
      </li>
      <li>Group projects with a team of alike individuals</li>
      <li>
        Global Network across <abbr>US</abbr>, <abbr>UK</abbr>, Europe
        and beyond
      </li>
    </ul>
  </div>

  <div class="sm:col-span-5 sm:col-start-2 lg:mt-12">
    <Callout class="mt-10"
      >{
        isValidDateString(PUBLIC_COURSE_DEADLINE) ? (
          <span>
            Fellowship application deadline:
            <br />
            {toLongMonthDayYear(
              new Date(PUBLIC_COURSE_DEADLINE.trim()),
            ).replaceAll(" ", " ")}
          </span>
        ) : (
          <span>
            Fellowship cohorts launch twice a year — complete the course now
            and be ready when the next application cycle opens
          </span>
        )
      }
    </Callout>

    <div class="mt-3 flex w-full flex-col items-center gap-4 lg:mt-2 lg:gap-5">
      <a
        href="https://racap.thinkific.com/courses/biotechunveiled?utm_source=BucketChallenge&utm_medium=BucketChallenge&utm_campaign=Team2"
        class="font-display bg-accent hover:bg-accent-mix-1 mt-3 inline-block rounded px-5 pt-1.5 pb-2 text-xl font-medium text-white transition-colors lg:mt-6 lg:pb-2.75 lg:text-3xl"
        style="letter-spacing: -0.4%"
        data-umami-event="Course Button"
      >
        Start learning
      </a>

      <Link
        href="https://www.nopatientleftbehind.org/nplb-fellowship"
        target="_blank"
        class="text-xs lg:text-base"
        dataUmamiEvent="Fellowship Link"
        ><abbr>NPLB</abbr> Fellowship website</Link
      >
    </div>
  </div>
</section>

<style>
  li {
    line-height: 135%;
  }
</style>
