---
import spiralImage from "../../assets/spiral.svg";

import computerIcon from "../../assets/icons/computer.svg";
import clockIcon from "../../assets/icons/clock.svg";
import certificateIcon from "../../assets/icons/certificate.svg";

import Partners from "../molecules/Partners.astro";
---

<section class="relative overflow-hidden">
  <div
    class="mx-auto max-w-md overflow-y-hidden p-4 lg:max-w-360 lg:px-16 lg:py-6 lg:pb-28"
  >
    <Partners />

    <div
      class="pointer-events-none absolute top-46 -left-24 lg:hidden"
      style="width: 18.5rem; transform: rotate(-70.07deg); transform-origin: top left;"
    >
      <img
        src={spiralImage.src}
        width={spiralImage.width}
        height={spiralImage.height}
        alt=""
      />
    </div>

    <div
      class="pointer-events-none absolute top-132 -left-120 hidden lg:block"
      style="width: 50rem; transform: rotate(-78.07deg) scale(1.3, 1.5); transform-origin: top left;"
    >
      <img src={spiralImage.src} alt="" class="w-full" />
    </div>

    <div class="relative max-w-min">
      <a
        href="https://www.nopatientleftbehind.org/nplb-fellowship"
        target="_blank"
        class="absolute -top-24 -right-9 flex items-center justify-center bg-[url(/icons/blob.svg)] bg-contain bg-no-repeat lg:hidden"
        style="height: 6.25rem; width: 6.25rem;"
        data-umami-event="Fellowship Blob"
      >
        <p
          class="font-display -ml-px text-center leading-tight font-bold text-white"
          style="margin-top: -0.4375rem;"
        >
          A step to the NPLB Fellowship
        </p>
      </a>

      <div
        class="absolute -top-1 -right-65 hidden items-center justify-center bg-[url(/icons/blob.svg)] bg-contain bg-no-repeat lg:flex"
        style="height: 12.5rem; width: 12.5rem;"
      >
        <p
          class="font-display -ml-1.5 text-center text-3xl leading-tight font-bold text-white"
          style="margin-top: -1rem;"
        >
          A step to the NPLB Fellowship
        </p>
      </div>

      <h1
        class="font-display tech-gradient lg:text-10xl mt-38 -ml-px bg-clip-text text-7xl font-bold text-transparent lg:mt-16 lg:-ml-2"
        style="line-height: 92%; letter-spacing: -2%;"
      >
        Biotech Unveiled <span class="sr-only"
          >— Free Online Course on How the Biotech Industry Works</span
        >
      </h1>
    </div>

    <h2
      class="font-display mt-6 mb-0.5 font-medium lg:mt-10 lg:max-w-138 lg:text-2xl"
      style="line-height: 145%;"
    >
      A free course by RA Capital and No Patient Left Behind about how medicines
      can be both affordable for patients and profitable to develop
    </h2>

    <a
      href="https://racap.thinkific.com/courses/biotechunveiled?utm_source=BucketChallenge&utm_medium=BucketChallenge&utm_campaign=Team2"
      class="font-display bg-accent hover:bg-accent-mix-1 mt-3 inline-block rounded px-5 pt-1.5 pb-2 text-xl font-medium text-white transition-colors lg:mt-6 lg:text-3xl"
      style="letter-spacing: -0.4%"
      data-umami-event="Course Button"
    >
      Join the course
    </a>

    <div
      class="mt-14 flex items-center justify-center gap-5 lg:mt-20 lg:gap-16"
    >
      <div class="flex flex-col items-center justify-center gap-3 lg:gap-6">
        <img src={computerIcon.src} alt="" class="h-6 lg:h-13" />
        <p
          class="font-display text-primary text-center text-sm uppercase lg:text-2xl"
          style="line-height: 160%; letter-spacing: 6%;"
        >
          Self-paced<br />and online
        </p>
      </div>

      <div class="flex flex-col items-center justify-center gap-3 lg:gap-6">
        <img src={clockIcon.src} alt="" class="h-6 lg:h-13" />
        <p
          class="font-display text-primary text-center text-sm uppercase lg:text-2xl"
          style="line-height: 160%; letter-spacing: 6%;"
        >
          6-10 hours<br />duration
        </p>
      </div>

      <div class="flex flex-col items-center justify-center gap-3 lg:gap-6">
        <img src={certificateIcon.src} alt="" class="h-6 lg:h-13" />
        <p
          class="font-display text-primary text-center text-sm uppercase lg:text-2xl"
          style="line-height: 160%; letter-spacing: 6%;"
        >
          Reputable<br />certificate
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-gradient {
    background-image: radial-gradient(
      at 5% 90%,
      var(--color-accent) 0%,
      var(--color-accent-mix-1) 10%,
      var(--color-accent-mix-2) 25%,
      var(--color-primary) 75%
    );
  }
</style>
